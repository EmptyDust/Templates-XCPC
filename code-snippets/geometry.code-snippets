			"        auto u = p[i];",
			"        auto v = p[(i + 1) % n];",
			"        auto w = p[(i + 2) % n];",
			"        auto [t, p1, p2] = segmentIntersection(l, Line(u, v));",
			"        if (t == 1) return false;",
			"        if (t == 0) continue;",
			"        if (t == 2) {",
			"            if (pointOnSegment(v, l) && v != l.a && v != l.b) {",
			"                if (cross(v - u, w - v) > 0) {",
			"                    return false;",
			"                }",
			"            }",
			"        } else {",
			"            if (p1 != u && p1 != v) {",
			"                if (L(l.a, Line(v, u)) || L(l.b, Line(v, u))) {",
