			"P circumCenter(P a, P b, P c) {",
			"    ///三角形外心",
			"    P bb = b - a, cc = c - a;",
			"    double db = bb.abs2(), dc = cc.abs2(), d = 2 * bb.det(cc);",
			"    return a - P(bb.y * dc - cc.y * db, cc.x * db - bb.x * dc) / d;",
