			"P inCenter(P A, P B, P C) {",
			"    ///三角形内心",
			"    double a = (B - C).abs(), b = (C - A).abs(), c = (A - B).abs();",
			"    return (A * a + B * b + C * c) / (a + b + c);",
			"}",
