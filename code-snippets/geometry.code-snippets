			"template<typename T>",
			"bool segmentInPolygon(Line<T> l, std::vector<Point<T>> p) {",
			"// 线段与多边形边界不相交且两端点都在多边形内部",
			"#define L(x, y) pointOnLineLeft(x, y)",
