		"body": [
			"std::pair<Pd, ld> pointToCircle(Pd p, Pd o, ld r) {",
			"    Pd U = o, V = o;",
			"    ld d = dis(p, o);",
			"    if (sign(d) == 0) { // p 为圆心时返回圆心本身",
			"        return {o, 0};",
			"    }",
			"    ld val1 = r * std::abs(o.x - p.x) / d;",
			"    ld val2 = r * std::abs(o.y - p.y) / d * ((o.x - p.x) * (o.y - p.y) < 0 ? -1 : 1);",
			"    U.x += val1, U.y += val2;",
			"    V.x -= val1, V.y -= val2;",
			"    if (dis(U, p) < dis(V, p)) {",
			"        return {U, dis(U, p)};",
			"    } else {",
			"        return {V, dis(V, p)};",
