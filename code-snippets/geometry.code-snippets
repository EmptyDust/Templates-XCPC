			"        if (k.x == 0 && k.y < 0) k.y = -k.y;",
			"        Point<int> P = up.upper_bound({{0, 0}, k})->a;",
			"        Point<int> Q = -low.upper_bound({{0, 0}, k})->a;",
			"        return sign(A * P.x + B * P.y - C) * sign(A * Q.x + B * Q.y - C) > 0;",
			"    }",
			"    friend ostream &operator<<(ostream &out, const ConvexHull &ch) {",
