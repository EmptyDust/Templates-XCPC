			"",
			"db convexDiamter(std::vector<P> ps) {",
			"    ////求凸包最大直径",
			"    int n = ps.size();",
			"    if (n <= 1)return 0;",
			"    int is = 0;",
			"    int js = 0;",
			"    for (int k = 1; k < n; ++k) {",
			"        is = ps[k] < ps[is] ? k : is, js = ps[js] < ps[k] ? k : js;",
			"    }",
			"    int i = is, j = js;",
			"    db ret = ps[i].disTo(ps[j]);",
			"    do {",
