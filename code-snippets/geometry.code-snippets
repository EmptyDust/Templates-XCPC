			"",
			"bool onSeg_strict(P p1, P p2, P q) {",
			"    ////p是不是严格在线段p1,p2上",
			"    return crossOp(p1, p2, q) == 0 && sign((q - p1).dot(p1 - p2)) * sign((q - p2).dot(p1 - p2)) < 0;",
