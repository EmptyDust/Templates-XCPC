			"db disSS(P p1, P p2, P q1, P q2) {",
			"    ////求线段p1p2到q1q2的距离",
			"    if (isSS(p1, p2, q1, q2))return 0;",
			"    return std::min(std::min(nearest(p1, p2, q1), nearest(p1, p2, q2)), std::min(nearest(q1, q2, p1), nearest(q1, q2, p2)));",
			"}",
			"//极角排序",
			"/*",
