			"    return {q1 - q2, q1 + q2};",
			"}",
			"",
			"std::vector<std::pair<P, P>> tancCC(P o1, db r1, P o2, db r2) {",
			"    ///两个圆的外切线,如果需要内切线,把r2传入负值即可,如果需要点到圆的切线,把r2传为0即可",
			"    P d = o2 - o1;",
			"    db dr = r1 - r2, d2 = d.abs2(), h2 = d2 - dr * dr;",
			"    if (sign(d2) == 0 || sign(h2) < 0)return {};",
