			"",
			"std::pair<P, db> min_circle(std::vector<P> ps) {",
			"    ///最小圆覆盖,给定若干个点,求最小的一个圆能够覆盖这些点,复杂度为O(n)",
			"    random_shuffle(ps.begin(), ps.end());",
			"    int n = ps.size();",
			"    P o = ps[0];",
			"    db r = 0;",
			"    for (int i = 1; i < n; ++i) {",
			"        if (o.disTo(ps[i]) > r + EPS)",
			"            o = ps[i], r = 0;",
			"        for (int j = 0; j < i; ++j)",
			"            if (o.disTo(ps[j]) > r + EPS) {",
			"                o = (ps[i] + ps[j]) / 2;",
			"                r = o.disTo(ps[i]);",
			"                for (int k = 0; k < j; ++k)",
			"                    if (o.disTo(ps[k]) > r + EPS) {",
			"                        o = circumCenter(ps[i], ps[j], ps[k]);",
			"                        r = o.disTo(ps[i]);",
			"                    }",
			"            }",
			"    }",
			"    return {o, r};",
			"}",
