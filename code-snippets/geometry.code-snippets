			"    } else if (A == 0) {",
			"        if (B < 0) {",
			"            B = -B, C = -C;",
			"        } else if (B == 0 && C < 0) {",
			"            C = -C;",
			"        }",
			"    }",
			"    if (A == 0) {  // 数值计算",
			"        if (B == 0) {",
			"            C = 0;  // 共点特判",
			"        } else {",
			"            T g = fgcd(abs(B), abs(C));",
			"            B /= g, C /= g;",
			"        }",
			"    } else if (B == 0) {",
			"        T g = fgcd(abs(A), abs(C));",
			"        A /= g, C /= g;",
			"    } else {",
			"        T g = fgcd(fgcd(abs(A), abs(B)), abs(C));",
			"        A /= g, B /= g, C /= g;",
			"    }",
			"    return tuple{A, B, C};  // Ax + By = C",
			"}"
