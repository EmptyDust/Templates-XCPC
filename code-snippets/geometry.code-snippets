	"len": {
		"scope": "cpp",
		"prefix": "len",
		"body": [
			"ld len(const P3 &p) {  // 原点到当前点的距离计算",
			"    return sqrt(p.x * p.x + p.y * p.y + p.z * p.z);",
			"}",
			"P3 crossEx(const P3 &a, const P3 &b) { // 叉乘",
			"    P3 ans;",
			"    ans.x = a.y * b.z - a.z * b.y;",
			"    ans.y = a.z * b.x - a.x * b.z;",
			"    ans.z = a.x * b.y - a.y * b.x;",
			"    return ans;",
			"}",
			"ld cross(const P3 &a, const P3 &b) {",
			"    return len(crossEx(a, b));",
			"}",
			"ld dot(const P3 &a, const P3 &b) { // 点乘",
			"    return a.x * b.x + a.y * b.y + a.z * b.z;",
			"}",
			"P3 getVec(const Plane &s) { // 获取平面法向量",
			"    return crossEx(s.u - s.v, s.v - s.w);",
			"}",
			"ld dis(const P3 &a, const P3 &b) { // 三维欧几里得距离公式",
			"    ld val = (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) + (a.z - b.z) * (a.z - b.z);",
			"    return sqrt(val);",
			"}",
			"P3 standardize(const P3 &vec) { // 将三维向量转换为单位向量",
			"    return vec / len(vec);",
			"}"
		],
		"description": "向量模长"
	},
