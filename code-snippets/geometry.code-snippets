			"    if (cmp(d, std::abs(r1 - r2)) == -1)return {};",
			"    d = std::min(d, r1 + r2);",
			"    db y = (r1 * r1 + d * d - r2 * r2) / (2 * d), x = std::sqrt(r1 * r1 - y * y);",
