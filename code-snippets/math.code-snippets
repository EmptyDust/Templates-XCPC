			"std::vector<i64> get_linear_basis(std::vector<i64>& nums, int N = 63) {",
			"    std::vector<i64> p(N + 1);",
			"    auto insert = [&](i64 x) {",
			"        for (int s = N;s >= 0;--s)if (x >> s & 1) {",
			"            if (!p[s]) {",
			"                p[s] = x;",
			"                break;",
			"            }",
