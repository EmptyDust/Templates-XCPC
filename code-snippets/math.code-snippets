			"             // prime[j] 是合数 i * prime[j] 的最小质因子",
			"            v[i * prime[j]] = prime[j];",
			"            phi[i * prime[j]] = phi[i] * (i % prime[j] ? prime[j] - 1 : prime[j]);",
			"        }",
			"    }",
			"}",
			"int main() {",
