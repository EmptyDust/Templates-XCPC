			"int v[N], prime[N], phi[N];",
			"void euler(int n) {",
			"    ms(v, 0); //最小质因子",
			"    int m = 0; //质数数量",
			"    for (int i = 2; i <= n; ++ i) {",
			"        if (v[i] == 0) { // i 是质数",
			"            v[i] = i, prime[++ m] = i;",
			"            phi[i] = i - 1;",
			"        }",
