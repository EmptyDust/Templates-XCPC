			"    // 0-index，边权非负；有限最短距离须小于 LLONG_MAX，用它表示不可达。",
			"    int n = adj.size();",
			"    const i64 inf = LLONG_MAX;",
			"    vector<i64> distance(n, inf);",
			"    using Entry = pair<i64, int>;",
			"    priority_queue<Entry, vector<Entry>, greater<Entry>> q;",
			"    distance[s] = 0;",
			"    q.push({0, s});",
			"    while (!q.empty()) {",
			"        auto [d, u] = q.top();",
			"        q.pop();",
			"        if (d != distance[u]) continue;",
			"        for (auto [v, w] : adj[u]) {",
			"            assert(w >= 0);",
			"            if (w >= inf - d) continue;",
			"            i64 next = d + w;",
			"            if (next < distance[v]) {",
			"                distance[v] = next;",
			"                q.push({distance[v], v});",
			"            }",
			"        }",
			"    }",
			"    return distance;",
			"}"
