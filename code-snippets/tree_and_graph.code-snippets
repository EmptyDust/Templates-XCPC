			"        siz[u] = 1;",
			"        for (auto v : e[u]) {",
			"            if (v == fa) continue;",
			"            dfs1(v, u);",
			"            siz[u] += siz[v];",
			"            if (siz[v] > siz[son[u]]) son[u] = v;",
			"        }",
			"    }",
			"    void calc(int u, int fa, int val) {",
			"        cnt[color[u]] += val;",
			"        if (cnt[color[u]] > Max) {",
			"            Max = cnt[color[u]];",
			"            sum = color[u];",
			"        } else if (cnt[color[u]] == Max) {",
			"            sum += color[u];",
			"        }",
			"        for (auto v : e[u]) {",
			"            if (v == fa || v == hson) continue;",
			"            calc(v, u, val);",
			"        }",
			"    }",
			"    void dfs2(int u, int fa, int opt) {",
			"        for (auto v : e[u]) {",
			"            if (v == fa || v == son[u]) continue;",
