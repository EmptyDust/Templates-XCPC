			"        }",
			"    }",
			"    void add(int x, int y) {",
			"        ver[++tot] = y, ne[tot] = h[x], h[x] = tot;",
			"        ++deg[y];",
			"    }",
			"    void dfs(int x) {",
			"        a.push_back(x);  // DFS序",
			"        siz[x] = vis[x] = 1;",
			"        for (int i = h[x]; i; i = ne[i]) {",
			"            int y = ver[i];",
			"            if (vis[y]) continue;",
			"            dis[y] = dis[x] + 1;",
			"            dfs(y);",
			"            siz[x] += siz[y];",
			"        }",
			"        a.push_back(x);",
			"    }",
			"    void bfs(int s) {",
			"        fill(dis, dis + n + 1, 0);",
			"        queue<int> q;",
			"        q.push(s);",
			"        dis[s] = 1;",
			"        while (!q.empty()) {",
			"            int x = q.front();",
			"            q.pop();",
			"            for (int i = h[x]; i; i = ne[i]) {",
			"                int y = ver[i];",
			"                if (dis[y]) continue;",
			"                dis[y] = dis[x] + 1;",
			"                q.push(y);",
			"            }",
			"        }",
			"    }",
			"    bool topsort() {",
			"        vector<int> indegree(deg, deg + n + 1);",
			"        queue<int> q;",
			"        vector<int> ans;",
			"        for (int i = 1; i <= n; ++i)",
