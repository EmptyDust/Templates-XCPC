			"            maxdep[u] = std::max(maxdep[u], maxdep[v]);",
			"        }",
			"    }",
			"",
			"    void dfs1(int u, int fa) {",
			"        for (auto [w, v] : e[u]) {",
			"            if (v == fa) continue;",
			"            dfs1(v, u);",
			"            int x = d1[v] + w;",
			"            if (x > d1[u]) {",
			"                d2[u] = d1[u], s2[u] = s1[u];",
