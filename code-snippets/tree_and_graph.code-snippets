			"    void add(int u, int v, int w) {",
			"        e[u].push_back({w, v});",
			"        e[v].push_back({w, u});",
			"    }",
			"    void dfs(int u, int fa) {",
			"        maxdep[u] = dep[u];",
			"        for (auto [w, v] : e[u]) {",
			"            if (v == fa) continue;",
			"            dep[v] = dep[u] + 1;",
			"            parent[v] = u;",
