			"    queue<int> q;",
			"    for (int v = 0; v < n; ++v) q.push(v);",
			"    while (!q.empty()) {",
			"        int u = q.front();",
			"        q.pop();",
			"        queued[u] = false;",
			"        for (auto [v, w] : adj[u]) {",
			"            if (d[v] <= d[u] + w) continue;",
			"            d[v] = d[u] + w;",
			"            length[v] = length[u] + 1;",
			"            if (length[v] >= n) return true;",
			"            if (!queued[v]) {",
			"                q.push(v);",
			"                queued[v] = true;",
			"            }",
			"        }",
			"    }",
			"    return false;",
			"}"
